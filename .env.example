# Приклад для локального запуску — скопіюй в .env.local та встав свої значення
# Отримати з Vercel Storage → Prisma Postgres → .env
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full"
# Vercel також дає STORAGE_* — можна лишити для сумісності, але достатньо DATABASE_URL
# STORAGE_PRISMA_DATABASE_URL="postgres://..."
# STORAGE_POSTGRES_URL="postgres://..."

# Auth.js (NextAuth) — згенеруй: npx auth secret або openssl rand -hex 32
AUTH_SECRET="заміни-на-випадковий-hex-32байти"
# AUTH_URL потрібен для продакшену: https://твій-домен
# AUTH_TRUST_HOST=true дозволено в auth.ts
